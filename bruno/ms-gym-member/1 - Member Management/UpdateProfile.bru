meta {
  name: UpdateProfile
  type: grpc
  seq: 3
}

grpc {
  url: {{host}}:{{grpc_port}}
  method: /member.v1.MemberService/UpdateProfile
  body: json
  protoFilePath: proto/member/v1/member.proto
}

headers {
  authorization: Bearer {{token}}
}

body:json {
  {
    "member_id": "{{member_id}}",
    "full_name": "John Doe Updated",
    "phone": "0901234567",
    "avatar_url": "https://avatar.example.com/john.jpg",
    "emergency_contact": "Jane Doe - 0907654321"
  }
}
